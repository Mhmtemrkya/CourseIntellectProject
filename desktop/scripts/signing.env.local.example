# macOS imzalama + notarization kimlik bilgileri.
#
# KULLANIM:
#   cp scripts/signing.env.local.example scripts/signing.env.local
#   (signing.env.local GITIGNORE'dadır — asla commit edilmez. Buradaki değerleri doldur.)
#   Sonra:  npm run desktop:build:signed
#
# Bir kez doldurunca her build otomatik yükler; artık her seferinde export etmene gerek yok.

# ── İmza kimliği (boş bırakırsan Keychain'deki Developer ID otomatik bulunur) ──
# export APPLE_SIGNING_IDENTITY="Developer ID Application: Adiniz (TEAMID)"

# ── YÖNTEM A: Apple ID + UYGULAMAYA ÖZEL parola ───────────────────────────────
# APPLE_PASSWORD normal Apple ID parolan DEĞİLDİR (401 hatası buradan gelir).
# https://appleid.apple.com > Oturum aç > "Uygulamaya Özel Parolalar" > üret (xxxx-xxxx-xxxx-xxxx)
export APPLE_ID="apple-hesabiniz@ornek.com"
export APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
export APPLE_TEAM_ID="TEAMID"

# ── YÖNTEM B (ÖNERİLİR): App Store Connect API anahtarı — süresi dolmaz ────────
# App Store Connect > Users and Access > Integrations > App Store Connect API > + ile üret
# (Developer rolü yeterli). .p8 dosyasını indir; Issuer ID ve Key ID'yi not al.
# Yöntem B kullanacaksan yukarıdaki A satırlarını yorum yap (#) ve aşağıyı aç:
# export APPLE_API_ISSUER="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# export APPLE_API_KEY="XXXXXXXXXX"
# export APPLE_API_KEY_PATH="$HOME/keys/AuthKey_XXXXXXXXXX.p8"
