    "date-fns": "^3.6.0",
    "dompurify": "^3.4.16",
    "framer-motion": "^12.26.2",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.507.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-day-picker": "8.10.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "react-scripts": "5.0.1",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7"
