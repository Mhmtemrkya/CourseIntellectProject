  "scripts": {
    "build": "node ./node_modules/@craco/craco/dist/bin/craco.js build",
    "test": "node ./node_modules/@craco/craco/dist/bin/craco.js test",
    "start": "node ./node_modules/@craco/craco/dist/bin/craco.js start",
    "start:prod": "REACT_APP_COURSE_INTELLECT_ENV=production node ./node_modules/@craco/craco/dist/bin/craco.js start",
    "smoke:roles": "node ./scripts/role-smoke.mjs",
    "predesktop:dev": "bash scripts/macos-build-preflight.sh",
    "desktop:dev": "PATH=\"/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH\" CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse CARGO_HTTP_TIMEOUT=600 CARGO_NET_RETRY=10 node ./node_modules/@tauri-apps/cli/tauri.js dev",
    "predesktop:build:app": "bash scripts/macos-build-preflight.sh",
    "desktop:build:app": "PATH=\"/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH\" CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse CARGO_HTTP_TIMEOUT=600 CARGO_NET_RETRY=10 node ./node_modules/@tauri-apps/cli/tauri.js build --bundles app",
    "desktop:build": "bash scripts/build-macos-signed.sh",
    "predesktop:build:app:prod": "bash scripts/macos-build-preflight.sh",
    "desktop:build:app:prod": "REACT_APP_COURSE_INTELLECT_ENV=production PATH=\"/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH\" CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse CARGO_HTTP_TIMEOUT=600 CARGO_NET_RETRY=10 node ./node_modules/@tauri-apps/cli/tauri.js build --bundles app",
    "desktop:build:prod": "bash scripts/build-macos-signed.sh",
    "desktop:build:unsigned": "bash scripts/macos-build-preflight.sh && swift scripts/generate-dmg-background.swift && REACT_APP_COURSE_INTELLECT_ENV=production PATH=\"/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH\" CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse CARGO_HTTP_TIMEOUT=600 CARGO_NET_RETRY=10 node ./node_modules/@tauri-apps/cli/tauri.js build --bundles dmg",
    "desktop:build:signed": "bash scripts/build-macos-signed.sh",
    "desktop:version": "node scripts/set-desktop-version.mjs",
    "typecheck": "tsc --noEmit -p .",
    "ts:gate": "node ./scripts/ts-strict-gate.mjs",
    "api:types": "node ./scripts/generate-api-types.mjs",
    "api:types:check": "node ./scripts/generate-api-types.mjs --check"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@craco/craco": "^7.1.0",
    "@eslint/js": "9.39.4",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/jest": "^27.5.2",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
