<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sertleştirilmiş çalışma zamanı (notarizasyon için) altında sınav
         gözetimi ve öğrenci/personel fotoğrafı için kamera erişimi. Mikrofon
         hiçbir yerde kullanılmadığından istenmez (App Review 2.4.5(i)). -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- API'ye giden ağ istemcisi erişimi. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
