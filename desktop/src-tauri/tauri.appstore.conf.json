{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeBuildCommand": "REACT_APP_COURSE_INTELLECT_ENV=production REACT_APP_DISTRIBUTION_CHANNEL=mac-app-store npm run build",
    "features": [
      "mac-app-store"
    ]
  },
  "app": {
    "security": {
      "capabilities": [
        "mac-app-store"
      ]
    }
  },
  "plugins": {
    "updater": null
  },
  "bundle": {
    "targets": [
      "app"
    ],
    "category": "Education",
    "copyright": "2026 Maydanoz Yazılım",
    "createUpdaterArtifacts": false,
    "macOS": {
      "entitlements": ".appstore/Entitlements.plist",
      "files": {
        "embedded.provisionprofile": ".appstore/embedded.provisionprofile",
        "Resources/PrivacyInfo.xcprivacy": "PrivacyInfo.appstore.xcprivacy"
      }
    }
  }
}
